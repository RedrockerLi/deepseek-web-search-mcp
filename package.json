{
  "name": "deepseek-web-search-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing DeepSeek Web Search and Fetch APIs over stdio",
  "author": "RedrockerLi",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deepseek-web-search-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "npm run build && DEEPSEEK_INTEGRATION=1 vitest run tests/integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
